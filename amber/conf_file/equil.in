# 2. Equilibration (NPT, 300K, 1atm)
 &cntrl
  imin=0,           ! MD実行
  ntx=1, irest=0,   ! 新規開始
  nstlim=50000,     ! equilibrationSteps
  dt=0.002,         ! 2fs (OpenMMのdtに相当)
  
  ! 温度制御 (Langevin)
  ntt=3, temp0=300.0, gamma_ln=1.0, 
  ig=-1,            ! 乱数シード
  
  ! 圧力制御 (Berendsen or Monte Carlo)
  ntp=1, barostat=2, ! Monte Carlo Barostat相当
  pres0=1.0, taup=2.0,
  
  ! 周期境界と非結合相互作用
  ntb=2, cut=10.0,
  
  ! 拘束 (HBonds相当)
  ntc=2, ntf=2,     ! SHAKE (Bond to Hydrogen)
  
  ! 出力設定
  ntpr=1000, ntwr=1000, ntwx=1000,
 /
 